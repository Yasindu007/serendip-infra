# Supply-chain controls (specs/016-ui-mvp plan.md decision 10, ADR 0012).
# No dependency lifecycle script ever runs at install: that is how the
# Shai-Hulud worm executed and stole credentials.
ignore-scripts=true
# Exact versions only; the lockfile is the source of truth.
save-exact=true
strict-peer-dependencies=true
# Only the public registry, never a credentialed one.
registry=https://registry.npmjs.org/
